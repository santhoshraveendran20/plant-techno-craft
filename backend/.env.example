# Copy this file to backend/.env and edit the values.

# MySQL connection: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
# The database is created automatically on first start if the user has CREATE rights.
DATABASE_URL=mysql+pymysql://upi:upi_pass123@localhost:3306/upi_tracker?charset=utf8mb4

# Long random string used to sign login tokens (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-0123456789
JWT_EXPIRE_MINUTES=720
TIMEZONE=Asia/Kolkata

# Where the web app runs (CORS + links sent to customers: <PUBLIC_APP_URL>/pay/<token>)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
PUBLIC_APP_URL=http://localhost:5173

# Payment gateway adapter: "mock" (built-in test gateway with a payment simulator) or "razorpay"
PAYMENT_GATEWAY=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret
MOCK_GATEWAY_FEE_PERCENT=0

# Razorpay (only when PAYMENT_GATEWAY=razorpay). Keys stay on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# First owner account, created only when the users table is empty
DEFAULT_OWNER_USERNAME=owner
DEFAULT_OWNER_PASSWORD=owner123
DEFAULT_OWNER_NAME=Shop Owner
